all : lib2d.a

clean :
	rm *.o
	rm lib2d.a

%.o : %.c
	$(CC) $(CFLAGS) $(INCFLAGS) -c $<

%.o : %.cpp
	$(CPP) $(CXXFLAGS) $(INCFLAGS) -c $<

%.o : %.s
	$(CPP) $(CXXFLAGS) -c $<

